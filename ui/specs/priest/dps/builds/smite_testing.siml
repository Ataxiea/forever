siml 1
spec dps_priest
talents "525235031030001001-30515100002-3"

settings:
  name "Player"
  race undead
  profession1 enchanting
  profession2 tailoring
  reaction_time_ms 100
  channel_clip_delay_ms 100
  distance_from_target 20
  healing_model()
  armor inner_fire
  pre_shadowform

gear:
  head       bad_hat
  neck       chains_of_the_lich
  shoulder   mantle_of_the_timbermaw
  back       deep_woodlands_cloak
  chest      ghostweave_vest
  wrist      netherlight_cuffs
  hands      radiant_gloves_ilvl55
  waist      wisdom_of_the_timbermaw
  legs       ghostweave_pants
  feet       earthen_silk_slippers
  finger1    jereman_band
  finger2    lorekeepers_ring_ilvl53
  trinket1   shard_of_the_splithooves
  trinket2   jewel_of_the_guard_captain
  main_hand  wisepaw_totem
  ranged     brilliant_wand
  bonus_stats()

item_swap: prepull_bonus_stats()

consumables:
  flask flask_of_supreme_power
  food nightfin_soup
  conjured demonic_rune
  mh_imbue brilliant_wizard_oil
  elixir elixir_of_shadow_power,
      greater_arcane_elixir,
      elixir_of_cunning,
      elixir_of_the_owl,
      elixir_of_sages,
      greater_mageblood_elixir,
      elixir_of_holy_power
  resource_pot major_mana_potion
  offensive_pot major_spellblasting_potion

buffs: greater_blessing_of_kings, greater_blessing_of_wisdom

party_buffs: mana_spring_totem

raid_buffs: arcane_brilliance, prayer_of_spirit, gift_of_the_wild, prayer_of_fortitude, moonkin_aura

debuffs: judgement_of_the_crusader, judgement_of_wisdom, curse_of_elements

encounter:
  duration 180
  duration_variation 5
  execute_proportion_20 0.2
  execute_proportion_35 0.35
  targets(id=31146,
      name="Raid Target",
      level=63,
      mob_type=mechanical,
      stats(attack_power=320, block_value=54, armor=3731, health=1428900),
      min_base_damage=2601,
      damage_spread=0.5,
      swing_speed=2,
      parry_haste,
      can_crush)

cooldowns:

prepull:
  -1s cast power_infusion

priority:
  cast shoot on target1 if current_mana_percent <= 10%
  cast holy_fire_rank5 if not dot(holy_fire_rank5).is_active and current_mana_percent <= 20%
  cast holy_fire if not dot(holy_fire).is_active and current_mana_percent >= 20%
  cast holy_nova if aura(holy_purpose).is_active(include_reaction_time=true) and number_targets >= 3
  cast shadow_word_pain if not target1.dot(shadow_word_pain).is_active
  # cast devouring_plague if spell(devouring_plague).can_cast
  # cast shadow_word_death on target1 if spell(shadow_word_death).can_cast
  # cast mind_blast if spell(mind_blast).can_cast
  cast penance if spell(penance).can_cast
  cast smite_rank5 if current_mana_percent <= 20%
  cast smite
