siml 1
spec retribution_paladin

def consecrated = not target.aura(consecration).is_known or target.aura(consecration).is_active
def seal_fading(seal) =
    aura(seal).remaining_time < auto_time_to_next(main_hand_auto)
    and aura(seal).is_inactive

prepull:
  -10s cast retribution_aura
  -1.5s cast seal_of_the_crusader

priority:
  autocast_other_cooldowns
  cast judgement
  when spell(item.manual_crowd_pummeler).is_known
      and aura(haste).is_inactive(include_reaction_time=true):
    item_swap(swap1)
        if active_item_swap_set(main)
        and spell(item.manual_crowd_pummeler).time_to_ready > 40s
    item_swap(main)
        if active_item_swap_set(swap1)
        and spell(item.manual_crowd_pummeler).time_to_ready <= 32s
        and remaining_time > 35s
  cast consecration
  cast hammer_of_wrath
      if spell(hammer_of_wrath).cast_time == 0s
      or auto_time_since_last(main_hand_auto) < 0.2s
  cast seal_of_righteousness if seal_fading(seal_of_righteousness_20293)
  cast holy_strike
  cast divine_favor if spell(holy_shock).is_ready and consecrated
  cast holy_shock if consecrated
  cast exorcism
