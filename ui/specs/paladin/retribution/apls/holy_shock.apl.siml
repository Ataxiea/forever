siml 1
spec retribution_paladin

prepull:
  -10s cast retribution_aura
  -1.5s cast seal_of_the_crusader

priority:
  autocast_other_cooldowns
  cast judgement
  item_swap(swap1)
      if spell(item.manual_crowd_pummeler).is_known
      and aura(haste).is_inactive(include_reaction_time=true)
      and active_item_swap_set(main)
      and spell(item.manual_crowd_pummeler).time_to_ready > 40s
  item_swap(main)
      if spell(item.manual_crowd_pummeler).is_known
      and aura(haste).is_inactive(include_reaction_time=true)
      and active_item_swap_set(swap1)
      and spell(item.manual_crowd_pummeler).time_to_ready <= 32s
      and remaining_time > 35s
  cast consecration
  cast hammer_of_wrath
      if spell(hammer_of_wrath).cast_time == 0s
      or auto_time_since_last(main_hand_auto) < 0.2s
  cast seal_of_righteousness
      if aura(seal_of_righteousness_20293).remaining_time < auto_time_to_next(main_hand_auto)
      and aura(seal_of_righteousness_20293).is_inactive
  cast holy_strike
  cast divine_favor
      if spell(holy_shock).is_ready
      and (not target.aura(consecrated_ground).is_known or target.aura(consecrated_ground).is_active)
  cast holy_shock
      if not target.aura(consecrated_ground).is_known
      or target.aura(consecrated_ground).is_active
  cast exorcism
