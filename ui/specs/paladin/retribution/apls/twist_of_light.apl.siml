siml 1
spec retribution_paladin

var ${Use Exorcism} = true
var ${Use Consecration} = true

def before_swing = auto_time_to_next(main_hand_auto) > 1.5s and current_mana_percent >= 10%
def seal_down(echo, seal) =
    aura(echo).is_inactive(include_reaction_time=true)
    and aura(seal).is_inactive

prepull:
  -10s cast retribution_aura
  -3s cast seal_of_command
  -1.5s cast seal_of_the_crusader

priority:
  autocast_other_cooldowns
  cast judgement
  cast hammer_of_wrath
      if spell(hammer_of_wrath).cast_time == 0s
      or auto_time_since_last(main_hand_auto) < 0.2s
  cast holy_strike if current_time > 0.5s
  cast seal_of_command if seal_down(echo_of_command, seal_of_command_20920)
  cast seal_of_righteousness if seal_down(echo_of_righteousness, seal_of_righteousness_20293)
  group "Consecration" if $use_consecration
  group "Exorcism" if $use_exorcism

group "Exorcism":
  cast exorcism if before_swing

group "Consecration":
  cast consecration if before_swing
