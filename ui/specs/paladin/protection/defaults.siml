siml 1
spec protection_paladin
use "gear_sets/default.gear.siml"
use "apls/default.apl.siml"

settings:
  race human
  profession1 engineering
  profession2 enchanting
  reaction_time_ms 100
  in_front_of_target
  distance_from_target 5
  healing_model(hps=2200,
      cadence_seconds=0.4,
      cadence_variation=1.2,
      absorb_frac=0.02,
      burst_window=6,
      inspiration_uptime=0.25)
  tanks player1

consumables:
  defensive_pot greater_stoneshield_potion
  flask flask_of_supreme_power
  food nightfin_soup
  conjured demonic_rune
  explosive ez_thro_dynamite_ii
  mh_imbue brilliant_wizard_oil
  extra goblin_sapper_charge, scroll_of_strength_iv, scroll_of_agility_iv, scroll_of_protection_iv

buffs: greater_blessing_of_kings, greater_blessing_of_might, greater_blessing_of_wisdom, thorns

party_buffs: mana_spring_totem, strength_of_earth_totem

raid_buffs:
  arcane_brilliance, prayer_of_spirit, gift_of_the_wild, prayer_of_fortitude
  prayer_of_shadow_protection

debuffs:
  judgement_of_light, judgement_of_wisdom, curse_of_elements, curse_of_recklessness, faerie_fire
  expose_armor, sunder_armor, insect_swarm

sim: iterations 25000
