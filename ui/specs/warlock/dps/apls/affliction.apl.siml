siml 1
spec warlock

priority:
  autocast_other_cooldowns
  cast_warlock_assigned_curse if not warlock_assigned_curse_is_active
  cast corruption if not dot(corruption).is_active
  cast bane_of_agony if not dot(bane_of_agony).is_active
  cast siphon_life if not dot(siphon_life).is_active
  cast shadow_bolt_rank10 if aura(shadow_trance).is_active
  cast death_coil
  cast life_tap if current_mana_percent < 15%
  channel wrack if not dot(wrack).is_active
  cast shadow_bolt_rank10
