siml 1
spec warlock
talents "2530000013-0004-0050355103101351"

settings:
  name "Player"
  race orc
  profession1 engineering
  profession2 tailoring
  distance_from_target 20
  summon succubus
  armor demon_armor
  soul_shards 32

consumables:
  flask flask_of_supreme_power
  food nightfin_soup
  conjured demonic_rune
  explosive ez_thro_dynamite_ii
  mh_imbue brilliant_wizard_oil
  offensive_pot major_spellblasting_potion

buffs: greater_blessing_of_kings, greater_blessing_of_wisdom

party_buffs: mana_spring_totem

raid_buffs: arcane_brilliance, prayer_of_spirit, gift_of_the_wild, prayer_of_fortitude, moonkin_aura

debuffs: judgement_of_wisdom

apl:
  var ${Doom tick} = 60s
  var ${Boost window} = 14s

priority:
  autocast_other_cooldowns
  group "Boosts"
      if dot(bane_of_doom).is_active and dot(bane_of_doom).remaining_time <= $boost_window
      or not dot(bane_of_doom).is_active and remaining_time < $doom_tick
  cast bane_of_doom if not dot(bane_of_doom).is_active and remaining_time >= $doom_tick
  cast bane_of_agony
      if not dot(bane_of_doom).is_active
      and not dot(bane_of_agony).is_active
      and remaining_time < $doom_tick
  cast_warlock_assigned_curse if not warlock_assigned_curse_is_active
  cast immolate if not dot(immolate).is_active
  cast corruption if not dot(corruption).is_active
  cast conflagrate if dot(immolate).is_active
  cast shadowburn
  cast incinerate
  cast life_tap

group "Boosts":
  cast blood_fury
  cast item.major_spellblasting_potion
