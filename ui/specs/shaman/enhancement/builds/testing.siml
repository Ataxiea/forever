siml 1
spec enhancement_shaman
talents "050533102-053030031005112251"

settings:
  name "Player"
  race orc
  profession1 engineering
  profession2 leatherworking
  reaction_time_ms 100
  distance_from_target 5
  healing_model()
  imbue_mh rockbiter_weapon

gear:
  head       black_dragonscale_helm + arcanum_of_rapidity
  neck       beads_of_ogre_might
  shoulder   horned_pauldron
  back       arcanoweave_cloak + cloak_agility
  chest      dawn_armor + chest_greater_stats
  wrist      wildheart_bracers + bracer_superior_strength
  hands      stormshroud_gloves + gloves_greater_strength
  waist      belt_of_preserved_heads
  legs       ironfeather_leggings + arcanum_of_rapidity
  feet       boots_of_the_five_thunders + boots_greater_agility
  finger1    band_of_the_better_half
  finger2    channelers_ring
  trinket1   adaptive_combat_assistant
  trinket2   frozen_heart_of_the_mountain
  main_hand  arcanite_reaper + weapon_crusader
  ranged     totem_of_the_storm
  bonus_stats()

item_swap: prepull_bonus_stats()

consumables:
  flask flask_of_supreme_power
  food smoked_desert_dumplings
  conjured demonic_rune
  explosive ez_thro_dark_bomb
  mh_imbue elemental_sharpening_stone
  extra goblin_sapper_charge
  elixir elixir_of_the_owl,
      elixir_of_sages,
      greater_mageblood_elixir,
      elixir_of_nature_power,
      greater_arcane_elixir,
      winterfall_firewater,
      elixir_of_cunning,
      elixir_of_ferocity
  resource_pot major_mana_potion

buffs: greater_blessing_of_kings, greater_blessing_of_might

party_buffs: battle_shout, leader_of_the_pack, strength_of_earth_totem, windfury_totem

raid_buffs: arcane_brilliance, gift_of_the_wild, prayer_of_fortitude

debuffs:
  hunters_mark, judgement_of_wisdom, curse_of_elements, curse_of_recklessness, faerie_fire
  expose_armor, sunder_armor, gift_of_arthas

encounter:
  duration 180
  duration_variation 5
  execute_proportion_20 0.2
  execute_proportion_25 0.25
  execute_proportion_35 0.35
  execute_proportion_45 0.45
  execute_proportion_90 0.9
  targets(id=31146,
      name="Raid Target",
      level=63,
      mob_type=mechanical,
      stats(attack_power=320, block_value=54, armor=3731, health=1299000),
      min_base_damage=15113,
      damage_spread=0.5,
      swing_speed=2,
      parry_haste,
      can_crush)

cooldowns:

prepull:
  -8s cast grace_of_air_totem
  -7s cast flametongue_totem
  -6s cast strength_of_earth_totem
  -5s cast mana_spring_totem

priority:
  cast other.resource_potion if current_mana_percent < 80%
  cast item.demonic_rune if current_mana_percent < 70%
  autocast_other_cooldowns
  cast grace_of_air_totem if totem_remaining_time(air) <= 0s
  cast strength_of_earth_totem if totem_remaining_time(earth) <= 0s
  cast fire_nova if aura(clearcasting).is_active(include_reaction_time=true)
  cast lightning_shield if not aura(lightning_shield).is_active
  cast searing_totem if totem_remaining_time(fire) <= 0s
  cast stormstrike
  cast lightning_bolt if aura(maelstrom_weapon).is_known and aura(maelstrom_weapon).num_stacks >= 5
  cast flame_shock if not dot(flame_shock).is_active
  cast earth_shock
  cast fire_nova if current_mana_percent > 10%
