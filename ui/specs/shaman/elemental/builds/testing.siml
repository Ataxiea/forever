siml 1
spec elemental_shaman
talents "3500301323113051-04-053150001001"

settings:
  name "Player"
  race troll
  profession1 leatherworking
  profession2 enchanting
  reaction_time_ms 100
  distance_from_target 20
  healing_model()

gear:
  head       blue_dragonscale_helm + lesser_arcane_amalgamation_1509
  neck       chains_of_the_lich + necklace_spell_power
  shoulder   mantle_of_the_timbermaw
  back       arcanoweave_cloak + cloak_subtlety
  chest      masters_vest of_magic + chest_major_intellect
  wrist      masters_bracers of_magic + bracer_superior_intellect
  hands      gloves_of_the_greatfather + gloves_natural_power
  waist      highlanders_cloth_girdle
  legs       ironfeather_leggings + lesser_arcane_amalgamation_1509
  feet       masters_boots of_magic + mystic_rugged_armor_kit
  finger1    blessed_band_of_light
  finger2    maidens_circle
  trinket1   weakness_analyzer
  trinket2   jewel_of_the_guard_captain
  main_hand  verimondes_last_resort + weapon_spell_power
  off_hand   spirit_of_aquementas
  ranged     totem_of_the_storm
  bonus_stats()

item_swap: prepull_bonus_stats()

consumables:
  flask flask_of_supreme_power
  food baked_salmon
  conjured demonic_rune
  mh_imbue brilliant_wizard_oil
  extra cerebral_cortex_compound
  elixir elixir_of_nature_power,
      arcane_elixir,
      elixir_of_sages,
      greater_mageblood_elixir,
      elixir_of_the_grizzly,
      elixir_of_the_mongoose,
      elixir_of_the_owl
  resource_pot major_mana_potion

buffs: greater_blessing_of_kings, greater_blessing_of_wisdom

party_buffs: moonkin_aura

raid_buffs: arcane_brilliance, prayer_of_spirit, gift_of_the_wild, prayer_of_fortitude

debuffs:
  judgement_of_wisdom, curse_of_elements, curse_of_recklessness, faerie_fire, expose_armor
  sunder_armor, gift_of_arthas

encounter:
  duration 60
  duration_variation 5
  execute_proportion_20 0.2
  execute_proportion_25 0.25
  execute_proportion_35 0.35
  execute_proportion_45 0.45
  execute_proportion_90 0.9
  targets(id=31146,
      name="Raid Target",
      level=63,
      mob_type=mechanical,
      stats(attack_power=320, block_value=54, armor=3731, health=1299000),
      min_base_damage=15113,
      damage_spread=0.5,
      swing_speed=2,
      parry_haste,
      can_crush)
  targets(id=31146,
      name="Raid Target",
      level=63,
      mob_type=mechanical,
      stats(attack_power=320, block_value=54, armor=3731, health=1299000),
      min_base_damage=2601,
      damage_spread=0.5,
      swing_speed=2,
      parry_haste,
      can_crush)
  targets(id=31146,
      name="Raid Target",
      level=63,
      mob_type=mechanical,
      stats(attack_power=320, block_value=54, armor=3731, health=1299000),
      min_base_damage=2601,
      damage_spread=0.5,
      swing_speed=2,
      parry_haste,
      can_crush)

cooldowns:

prepull:
  -4s cast strength_of_earth_totem
  -3s cast windfury_totem
  -2s cast mana_spring_totem
  -1s cast searing_totem if number_targets == 1

priority:
  cast other.resource_potion if current_mana_percent < 80%
  cast item.demonic_rune if current_mana_percent < 70%
  autocast_other_cooldowns
  cast mana_tide_totem if current_mana_percent < 50%
  cast searing_totem if number_targets == 1 and totem_remaining_time(fire) <= 0s
  cast magma_totem if number_targets > 1 and totem_remaining_time(fire) <= 0s
  cast fire_nova if number_targets > 1
  cast chain_lightning if number_targets > 1
  cast lava_burst if dot(flame_shock_rank5).is_active
  cast flame_shock_rank5 if not dot(flame_shock_rank5).is_active
  cast lightning_bolt_10392_tag0 if current_mana_percent < 20%
  cast lightning_bolt
