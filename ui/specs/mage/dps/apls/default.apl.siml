siml 1
spec mage

priority:
  autocast_other_cooldowns
  cast arcane_missiles if aura(missile_barrage).is_active(include_reaction_time=true)
  cast frostbolt_rank11
      if aura(arcane_blast).num_stacks >= 4
      and aura(missile_barrage).is_inactive(include_reaction_time=true)
  cast arcane_blast
