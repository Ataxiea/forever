siml 1
spec dps_warrior

def in_execute = is_execute_phase(e20)

var ${Delay Check} =
    spell(bloodthirst).time_to_ready >= 1.5s
    and spell(whirlwind).time_to_ready >= 1.5s
var ${Overpower: Can Cast} =
    $delay_check
    and not in_execute
    and or(aura(overpower).is_active(include_reaction_time=true) and current_rage >= 5 and current_rage <= 100)
var ${Rend: Can Cast} =
    action_group_used("Rend Weave ON/OFF")
    and $delay_check
    and not in_execute
    and dot(rend).remaining_time <= 3s
    and current_rage >= 10

prepull:
  -4.5s cast berserker_rage
  -3s cast bloodrage
  -3s cast battle_shout
  -0.9s group "Pre-pull: Move"

priority:
  # group "Recklessness ON/OFF"
  group "Rend Weave ON/OFF"
  group "Hamstring Weave ON/OFF"
  group "Engineering"
  group "CD: Trinkets"
  group "Sunder Armor" if number_targets == 1
  # group "Sunder Armor: Refresh" if number_targets == 1
  cast other.offensive_potion
  cast other.resource_potion
  group "CD: Racials"
  cast death_wish
  cast recklessness if and(action_group_used("Recklessness ON/OFF"))
  cast sweeping_strikes if and(number_targets > 1)
  cast whirlwind if number_targets > 1
  cast bloodthirst
  cast whirlwind if spell(bloodthirst).time_to_ready >= 1.5s
  cast execute if in_execute
  cast cleave if number_targets > 1 and or(current_rage >= 40)
  group "Overpower Weaving"
  cast hamstring
      if action_group_used("Hamstring Weave ON/OFF")
      and aura(windfury_totem_proc).is_known
      and $delay_check
      and not in_execute
  cast berserker_stance
      if aura(berserker_stance).is_inactive
      and (spell(bloodthirst).time_to_ready <= input_delay or spell(whirlwind).time_to_ready <= input_delay)
  cast heroic_strike if number_targets == 1 and not in_execute and current_rage >= 40
  cast heroic_strike if $delay_check and current_rage > 60
  cast bloodrage if current_rage < 90
  cast berserker_rage
      if $delay_check
      and (aura(improved_berserker_rage).is_known or aura(improved_berserker_rage_tag2).is_known)
  cast battle_shout
      if $delay_check
      and not aura(battle_shout_external).is_known
      and aura(battle_shout).remaining_time <= 10s
  # cast berserker_stance if not aura(berserker_stance).is_active
  # cast berserker_stance if not aura(berserker_stance).is_active
  # cast recklessness if false
  # cast retaliation if false
  # cast shield_wall if false

group "Pre-pull: Move":
  cast charge if aura(battle_stance).is_active
  cast intercept if aura(berserker_stance).is_active

group "Recklessness ON/OFF":
  none

group "Rend Weave ON/OFF":
  none

group "Hamstring Weave ON/OFF":
  none

group "Engineering":
  cast item.goblin_sapper_charge
  cast item.crystal_charge
  cast item.ez_thro_dynamite_ii

group "CD: Racials":
  cast blood_fury
  cast berserking

group "Sunder Armor":
  cast sunder_armor if target.aura(sunder_armor).num_stacks(include_reaction_time=true) < 5

group "Sunder Armor: Refresh":
  cast sunder_armor if $delay_check and target.aura(sunder_armor).remaining_time <= 10s

group "CD: Trinkets":
  cast_all_stat_buff_cooldowns(stat_type2=attack_power, stat_type3=haste_rating)
  cast_all_stat_buff_cooldowns(crit_rating, stat_type2=armor_penetration, stat_type3=-1)
  cast item.badge_of_the_swarmguard
  cast item.slayers_crest
  cast item.kiss_of_the_spider
  cast jom_gabbar
  cast item.shard_of_the_fallen_star
  cast item.everlook_pathcarver

group "Overpower Weaving":
  when $overpower_can_cast:
    wait gcd_time_to_ready if gcd_time_to_ready <= 100ms
    cast battle_stance if gcd_time_to_ready == 0ms
  cast overpower if aura(overpower).is_active
  cast rend if aura(battle_stance).is_active and $rend_can_cast
  cast berserker_stance
      if aura(berserker_stance).is_inactive
      and not spell(overpower).is_ready
      and not (aura(battle_stance).is_active and $rend_can_cast)
