siml 1
spec dps_warrior

def stance_dance = action_group_used("Stance Dance ON/OFF")
def in_battle_stance = aura(battle_stance).is_active
def in_execute = is_execute_phase(e20)
def rend_due = dot(rend).remaining_time <= 1.5s

var ${Delay Check} =
    spell(mortal_strike).time_to_ready >= 1.5s
    and (not stance_dance or spell(whirlwind).time_to_ready >= 1.5s)

prepull:
  -4.5s cast berserker_rage
  -4s group "Pre-pull: Stance"
  -3s cast bloodrage
  -3s cast battle_shout
  -0.9s group "Pre-pull: Move"

priority:
  # group "Recklessness ON/OFF"
  # group "Stance Dance ON/OFF"
  group "Hamstring Weave ON/OFF"
  group "Engineering"
  group "CD: Trinkets"
  group "Sunder Armor" if number_targets == 1
  # group "Sunder Armor: Refresh" if number_targets == 1
  cast other.offensive_potion
      if multiple_cd_usages(target_spell_id=other.offensive_potion, offset=0ms, align_cd_end=true)
  cast other.resource_potion
  group "CD: Racials"
  cast death_wish if multiple_cd_usages(target_spell_id=death_wish, offset=0ms, align_cd_end=true)
  cast recklessness
      if action_group_used("Recklessness ON/OFF")
      and multiple_cd_usages(target_spell_id=recklessness, offset=0ms, align_cd_end=true)
  cast sweeping_strikes if and(number_targets > 1)
  cast battle_stance if not stance_dance and aura(battle_stance).is_inactive
  cast mortal_strike if stance_dance
  cast rend if not in_execute and in_battle_stance and rend_due
  cast overpower if in_battle_stance
  cast mortal_strike if not stance_dance
  cast spearing_strike if not in_execute and in_battle_stance
  cast berserker_stance
      if stance_dance
      and in_battle_stance
      and aura(overpower).is_inactive
      and (in_execute or dot(rend).remaining_time > 1.5s)
  when not in_execute:
    cast slam if spell(slam).cast_time < 1.5s
    cast slam
        if spell(slam).cast_time >= 1.5s
        and auto_time_since_last(main_hand_auto) <= input_delay + 300ms
  cast whirlwind if stance_dance
  cast hamstring
      if action_group_used("Hamstring Weave ON/OFF")
      and aura(windfury_totem_proc).is_known
      and not in_execute
      and aura(windfury_totem_buff).is_inactive
  cast execute if in_execute
  cast battle_stance
      if stance_dance
      and not in_execute
      and aura(berserker_stance).is_active
      and (aura(overpower).is_active(include_reaction_time=true) or rend_due)
  cast cleave if number_targets > 1 and or(current_rage >= 40)
  cast heroic_strike if not in_execute and current_rage >= 90
  cast bloodrage if current_rage < 90
  cast battle_shout
      if $delay_check
      and not aura(battle_shout_external).is_known
      and aura(battle_shout).remaining_time <= 10s
  # cast recklessness if false
  # cast retaliation if false
  # cast shield_wall if false

group "Pre-pull: Stance":
  cast battle_stance if not stance_dance

group "Pre-pull: Move":
  cast charge if in_battle_stance
  cast intercept if aura(berserker_stance).is_active

group "Recklessness ON/OFF":
  none

group "Stance Dance ON/OFF":
  none

group "Hamstring Weave ON/OFF":
  none

group "Engineering":
  cast item.goblin_sapper_charge
  cast item.crystal_charge
  cast item.ez_thro_dynamite_ii

group "CD: Racials":
  cast blood_fury if multiple_cd_usages(target_spell_id=blood_fury, offset=0ms, align_cd_end=true)
  cast berserking if multiple_cd_usages(target_spell_id=berserking, offset=0ms, align_cd_end=true)
  cast eureka if multiple_cd_usages(target_spell_id=eureka, offset=0ms, align_cd_end=true)
  cast elunes_light
      if multiple_cd_usages(target_spell_id=elunes_light, offset=0ms, align_cd_end=true)

group "Sunder Armor":
  cast sunder_armor if target.aura(sunder_armor).num_stacks(include_reaction_time=true) < 5

group "Sunder Armor: Refresh":
  cast sunder_armor if $delay_check and target.aura(sunder_armor).remaining_time <= 10s

group "CD: Trinkets":
  cast_all_stat_buff_cooldowns(stat_type2=attack_power, stat_type3=haste_rating)
  cast_all_stat_buff_cooldowns(crit_rating, stat_type2=armor_penetration, stat_type3=-1)
  cast item.badge_of_the_swarmguard
  cast item.slayers_crest
  cast item.kiss_of_the_spider
  cast jom_gabbar
  cast item.shard_of_the_fallen_star
  cast item.everlook_pathcarver
